{
  "name": "pi-config",
  "version": "0.1.0",
  "private": true,
  "description": "Pi startup screen, themes, subagents, and parent-owned background terminals",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/startup-screen/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/skill-command-highlight/index.ts"
    ],
    "skills": [
      "./skills/background-terminals",
      "./skills/subagents"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types extensions/background-terminals/*.test.ts extensions/subagents/*.test.ts"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.99"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.24.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
